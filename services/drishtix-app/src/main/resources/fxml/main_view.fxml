<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.drishtix.controller.MainController"
            fx:id="rootPane" styleClass="root-pane"
            stylesheets="@../css/drishtix-dark.css">

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox styleClass="sidebar" prefWidth="70" spacing="0" alignment="TOP_CENTER">
            <padding><Insets top="15" bottom="15"/></padding>

            <!-- Logo Area -->
            <Label text="👁️" styleClass="sidebar-logo"/>
            <Label text="DrishtiX" styleClass="sidebar-brand"/>

            <Region VBox.vgrow="NEVER" prefHeight="20"/>

            <!-- Navigation Items -->
            <VBox fx:id="navDashboard" styleClass="nav-item, nav-active" alignment="CENTER">
                <Label text="📊" styleClass="nav-icon"/>
                <Label text="Dash" styleClass="nav-label"/>
            </VBox>

            <VBox fx:id="navRegistry" styleClass="nav-item" alignment="CENTER">
                <Label text="📋" styleClass="nav-icon"/>
                <Label text="Registry" styleClass="nav-label"/>
            </VBox>

            <VBox fx:id="navScanner" styleClass="nav-item" alignment="CENTER">
                <Label text="🖼" styleClass="nav-icon"/>
                <Label text="Scan" styleClass="nav-label"/>
            </VBox>

            <VBox fx:id="navLogs" styleClass="nav-item" alignment="CENTER">
                <Label text="📜" styleClass="nav-icon"/>
                <Label text="Logs" styleClass="nav-label"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox fx:id="navSettings" styleClass="nav-item" alignment="CENTER">
                <Label text="⚙" styleClass="nav-icon"/>
                <Label text="Config" styleClass="nav-label"/>
            </VBox>
        </VBox>
    </left>

    <!-- Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

    <!-- Status Bar -->
    <bottom>
        <HBox styleClass="status-bar" spacing="30" alignment="CENTER_LEFT">
            <padding><Insets top="5" bottom="5" left="15" right="15"/></padding>
            <Label fx:id="statusCamera" text="○ Camera: Inactive" styleClass="status-label"/>
            <Label fx:id="statusDb" text="● DB: Connected" styleClass="status-label"/>
            <Label fx:id="statusFps" text="FPS: 0" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusTargets" text="Targets: 0" styleClass="status-label"/>
        </HBox>
    </bottom>
</BorderPane>
