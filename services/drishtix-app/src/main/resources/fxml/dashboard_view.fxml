<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.drishtix.controller.DashboardController"
      styleClass="dashboard-pane" spacing="0">

    <!-- ============================================
         HEADER BAR — Dashboard Title + Action Icons
         ============================================ -->
    <HBox styleClass="dashboard-header" alignment="CENTER_LEFT" spacing="16">
        <Label text="Dashboard" styleClass="view-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="🔔" styleClass="header-icon" onMouseClicked="#handleNotificationsClick"/>
        <Label text="👤" styleClass="header-icon" onMouseClicked="#handleProfileClick"/>
    </HBox>

    <!-- ============================================
         BENTO GRID CONTAINER — 68/32 Column Ratio
         ============================================ -->
    <GridPane hgap="20" vgap="20" VBox.vgrow="ALWAYS">
        <padding><Insets top="0" right="24" bottom="24" left="24"/></padding>

        <columnConstraints>
            <ColumnConstraints percentWidth="68" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="32" hgrow="SOMETIMES"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints vgrow="ALWAYS"/>
            <RowConstraints vgrow="NEVER" prefHeight="112"/>
        </rowConstraints>

        <!-- ========================================
             CELL [0,0] — LIVE SURVEILLANCE FEED
             ======================================== -->
        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0"
              styleClass="bento-card" spacing="12">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="LIVE SURVEILLANCE FEED" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblFps" text="FPS: 0" styleClass="fps-label"/>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS" styleClass="camera-viewport">
                <ImageView fx:id="cameraFeedBg" smooth="true" opacity="0.25" preserveRatio="false"/>
                <ImageView fx:id="cameraFeed" fitWidth="640" fitHeight="480" preserveRatio="true" smooth="true"/>
                <StackPane fx:id="alertOverlay" visible="false" styleClass="alert-overlay"/>
            </StackPane>
        </VBox>

        <!-- ========================================
             CELL [1, 0-1] — RIGHT COLUMN (rowSpan=2)
             System Status & Live Alerts Queue
             ======================================== -->
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.rowSpan="2" spacing="20">

            <!-- Bento Card: System Status -->
            <VBox styleClass="bento-card" spacing="14">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>

                <Label text="System Status" styleClass="card-title"/>

                <!-- 2x2 Stat Mini-Grid -->
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="stat-card">
                        <Label text="Total Targets" styleClass="stat-title"/>
                        <Label fx:id="lblTotalTargets" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="stat-card">
                        <Label text="Today's Scans" styleClass="stat-title"/>
                        <Label fx:id="lblDetectionsToday" text="0" styleClass="stat-value-accent"/>
                    </VBox>
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="stat-card-criminal">
                        <Label text="Criminal Matches" styleClass="stat-title"/>
                        <Label fx:id="lblCriminals" text="0" styleClass="stat-value-red"/>
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="stat-card-missing">
                        <Label text="Missing Persons" styleClass="stat-title"/>
                        <Label fx:id="lblMissing" text="0" styleClass="stat-value-blue"/>
                    </VBox>
                </GridPane>

                <!-- System Indicators -->
                <VBox spacing="6" styleClass="indicators-box">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Camera:" styleClass="indicator-label"/>
                        <Label fx:id="lblCameraStatus" text="○ Inactive" styleClass="indicator-value"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Recognizer:" styleClass="indicator-label"/>
                        <Label fx:id="lblRecognizerStatus" text="○ Not Trained" styleClass="indicator-value"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Bento Card: Live Alerts Queue -->
            <VBox VBox.vgrow="ALWAYS" styleClass="bento-card" spacing="10">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>

                <Label text="Live Alerts Queue" styleClass="card-title"/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="alerts-scroll">
                    <VBox fx:id="alertQueueBox" spacing="10"/>
                </ScrollPane>

                <Separator/>

                <Button text="➕ Add Target" onAction="#handleQuickAddTarget"
                        styleClass="btn-add-target" maxWidth="Infinity"/>
            </VBox>
        </VBox>

        <!-- ========================================
             CELL [0,1] — CONTROL BAR
             ======================================== -->
        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1"
              styleClass="bento-card" spacing="10">
            <padding><Insets top="12" right="18" bottom="12" left="18"/></padding>

            <Label text="Control Bar" styleClass="card-title"/>

            <HBox spacing="20" alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
                <!-- Threshold Slider -->
                <VBox spacing="4">
                    <Label text="Threshold" styleClass="control-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Slider fx:id="confidenceSlider" min="10" max="200" value="80"
                                prefWidth="160" styleClass="threshold-slider"/>
                        <Label fx:id="lblConfidence" text="80" styleClass="control-value"/>
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Camera Selection -->
                <VBox spacing="4">
                    <Label text="Camera Selection" styleClass="control-label"/>
                    <ComboBox fx:id="cameraSelector" prefWidth="180" styleClass="control-combo"/>
                </VBox>

                <!-- Start/Stop Action -->
                <Button fx:id="btnStartStop" text="Start" onAction="#handleStartStop"
                        styleClass="btn-start-circle"/>

                <!-- Mute Toggle -->
                <ToggleButton fx:id="btnMute" text="🔊" styleClass="btn-mute"/>
            </HBox>
        </VBox>

    </GridPane>
</VBox>
