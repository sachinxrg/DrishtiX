<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.drishtix.controller.RegistryController"
            styleClass="view-pane, glass-bento-container">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <top>
        <VBox spacing="14" styleClass="registry-header-container">
            <!-- Header Title -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📇" style="-fx-font-size: 24;"/>
                <VBox spacing="2">
                    <Label text="TARGET REGISTRY" styleClass="view-title"/>
                    <Label fx:id="recordCountLabel" text="Loading records..." styleClass="registry-subtitle"/>
                </VBox>
            </HBox>

            <!-- Toolbar (Search, Filter, Actions) -->
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="registry-toolbar">
                <padding><Insets top="4" bottom="4" left="0" right="0"/></padding>

                <!-- Search Group (Neumorphic Inset) -->
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="neu-search-group" HBox.hgrow="ALWAYS" maxWidth="450">
                    <Label text="🔍" style="-fx-text-fill: #94A3B8; -fx-padding: 0 0 0 8;"/>
                    <TextField fx:id="searchField" promptText="Search by name or case number..." styleClass="neu-search-field" HBox.hgrow="ALWAYS"/>
                    <Separator orientation="VERTICAL" style="-fx-padding: 0 4;"/>
                    <ComboBox fx:id="categoryFilter" prefWidth="150" styleClass="neu-combo"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Action Group -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="➕ Add Target" onAction="#handleAddTarget" styleClass="neu-btn-primary"/>
                    <Button text="🔄 Refresh" onAction="#handleRefresh" styleClass="neu-btn-secondary"/>
                    <Separator orientation="VERTICAL" style="-fx-padding: 0 8;"/>
                    <Button text="🚫 Deactivate" onAction="#handleDeactivate" styleClass="neu-btn-warning"/>
                    <Button text="🗑️ Delete" onAction="#handleDeleteTarget" styleClass="neu-btn-danger"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding><Insets top="14"/></padding>

            <!-- Main Table (neumorphic inset) -->
            <VBox HBox.hgrow="ALWAYS" styleClass="neu-table-container">
                <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                <TableView fx:id="targetTable" VBox.vgrow="ALWAYS" styleClass="neu-data-table">
                    <placeholder>
                        <Label text="No targets registered yet.\nClick ➕ Add Target to begin." styleClass="table-empty-label"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="#" prefWidth="45" minWidth="45" maxWidth="60" sortable="false"/>
                        <TableColumn fx:id="colProfile" text="Profile" prefWidth="70" minWidth="70" maxWidth="80" sortable="false"/>
                        <TableColumn fx:id="colName" text="Full Name" prefWidth="170" minWidth="140"/>
                        <TableColumn fx:id="colCategory" text="Category" prefWidth="135" minWidth="110"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="90" minWidth="80"/>
                        <TableColumn fx:id="colCaseNumber" text="FIR No." prefWidth="120" minWidth="100"/>
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="190" minWidth="120"/>
                        <TableColumn fx:id="colCreatedAt" text="FIR Date" prefWidth="100" minWidth="90"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Panel (Bento Grid) -->
            <StackPane prefWidth="300" minWidth="300" styleClass="glass-bento-card">
                
                <!-- Empty State -->
                <VBox fx:id="emptyStatePanel" alignment="CENTER" spacing="10">
                    <Label text="👤" style="-fx-font-size: 36; -fx-text-fill: #94A3B8;"/>
                    <Label text="Select a target to view profile." style="-fx-text-fill: #94A3B8; -fx-font-size: 14; -fx-text-alignment: center;" wrapText="true"/>
                </VBox>

                <!-- Details State -->
                <VBox fx:id="detailsPanel" spacing="16" alignment="TOP_CENTER" visible="false">
                    <Label text="TARGET PROFILE" styleClass="glass-bento-card-title"/>
                    
                    <!-- Avatar Card (Bento Item 1) -->
                    <StackPane styleClass="neu-avatar-frame" prefWidth="180" prefHeight="180" maxWidth="180" maxHeight="180">
                        <Circle fx:id="profileAvatar" radius="85"/>
                    </StackPane>

                    <!-- Identity Card (Bento Item 2) -->
                    <VBox spacing="8" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                        <Label fx:id="previewName" text="-" styleClass="preview-name" wrapText="true" style="-fx-text-alignment: center;"/>
                        <Label fx:id="previewCategory" text="-"/>
                    </VBox>

                    <Separator style="-fx-padding: 5 0;"/>

                    <!-- Details Grid (Bento Item 3) -->
                    <GridPane hgap="12" vgap="12" alignment="CENTER_LEFT">
                        <Label text="FIR No:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #64748B; -fx-font-weight: bold;"/>
                        <Label fx:id="previewCase" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #1E293B;"/>
                        
                        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #64748B; -fx-font-weight: bold;"/>
                        <Label fx:id="previewStatus" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </GridPane>
                    
                    <!-- Description Panel (Bento Item 4) -->
                    <VBox spacing="4" alignment="TOP_LEFT" VBox.vgrow="ALWAYS" style="-fx-padding: 5 0 0 0;">
                        <Label text="Description:" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 12;"/>
                        <TextArea fx:id="previewDescription" text="-" wrapText="true" editable="false" 
                                  styleClass="glass-input" prefHeight="80" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-text-fill: #1E293B; -fx-font-size: 12;"/>
                    </VBox>
                </VBox>

            </StackPane>
        </HBox>
    </center>
</BorderPane>
