/* ==========================================================================
   DrishtiX v4.0 — Light Glassmorphism + Soft Neumorphism Theme (QSS)
   ==========================================================================
   Design Tokens (translated from Tailwind spec):
     Canvas 50:            #F8FAFC
     Canvas 100:           #F1F5F9
     Surface Glass:        rgba(255,255,255,174)  — 0.68 opacity
     Surface Glass Heavy:  rgba(255,255,255,220)  — 0.86 opacity
     Ink 900:              #0F172A   (headings, primary)
     Ink 700:              #334155   (body text)
     Ink 500:              #64748B   (metadata)
     Ink 400:              #94A3B8   (timestamps)
     Ink 300:              #CBD5E1   (borders)
     Accent:               #4F6BFB
     Accent Hover:         #3E56E0
     Accent Soft:          #EEF2FF
     Safe:                 #10B981   — active/ok
     Safe BG:              #ECFDF5
     Safe Border:          #A7F3D0
     Review:               #F59E0B   — needs attention
     Review BG:            #FFFBEB
     Review Border:        #FDE68A
     Critical:             #F43F5E   — alert/danger
     Critical BG:          #FFF1F2
     Critical Border:      #FECDD3
     Info:                 #06B6D4   — informational
     Info BG:              #ECFEFF
     Info Border:          #A5F3FC
     Hairline:             rgba(255,255,255,180)
     Hairline Ink:         rgba(15,23,42,20)
     Radius Tile:          22px
     Radius Card:          18px
     Radius Control:       12px
     Radius Pill:          999px
   ========================================================================== */


/* ═══════════════════════════════════════════════════════════════════════════
   1. GLOBAL RESET & WINDOW — Ambient Canvas
   ═══════════════════════════════════════════════════════════════════════════ */
QWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Inter", "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
    selection-background-color: #4F6BFB;
    selection-color: #FFFFFF;
}

QMainWindow {
    background-color: #F8FAFC;
}


/* ═══════════════════════════════════════════════════════════════════════════
   2. FRAMES & BENTO CARDS — Glassmorphic Surfaces
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame[class="bento-card"], QFrame[class="card-panel"] {
    background-color: rgba(255, 255, 255, 220);
    border: 1px solid rgba(255, 255, 255, 180);
    border-radius: 18px;
}

QFrame[class="bento-card"]:hover, QFrame[class="card-panel"]:hover {
    border: 1px solid #FFFFFF;
}


/* ═══════════════════════════════════════════════════════════════════════════
   3. NAVIGATION SIDEBAR — Frosted Glass Panel
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame#NavSidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
}

QPushButton[class="nav-btn"] {
    background-color: transparent;
    color: #64748B;
    text-align: left;
    padding: 10px 16px;
    border-radius: 10px;
    font-weight: 500;
    font-size: 13px;
    border: none;
}

QPushButton[class="nav-btn"]:hover {
    background-color: #EEF2FF;
    color: #334155;
}

QPushButton[class="nav-btn"]:checked {
    background-color: #EEF2FF;
    color: #4F6BFB;
    font-weight: 600;
    border-left: 3px solid #4F6BFB;
    border-radius: 0px 10px 10px 0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   4. BUTTONS — Neumorphic Raised Controls
   ═══════════════════════════════════════════════════════════════════════════ */
QPushButton {
    background-color: #F1F5F9;
    color: #0F172A;
    border: 1px solid rgba(255, 255, 255, 200);
    border-radius: 12px;
    padding: 8px 16px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
}

QPushButton:pressed {
    background-color: #E2E8F0;
    border-top: 1px solid #CBD5E1;
    border-left: 1px solid #CBD5E1;
    border-bottom: 1px solid #FFFFFF;
    border-right: 1px solid #FFFFFF;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QPushButton[class="btn-primary"] {
    background-color: #4F6BFB;
    color: #FFFFFF;
    border: 1px solid #4F6BFB;
    font-weight: 600;
    border-radius: 12px;
}

QPushButton[class="btn-primary"]:hover {
    background-color: #3E56E0;
    border-color: #3E56E0;
}

QPushButton[class="btn-primary"]:pressed {
    background-color: #3347C7;
}

QPushButton[class="btn-danger"] {
    background-color: #FFF1F2;
    color: #F43F5E;
    border: 1px solid #FECDD3;
    font-weight: 600;
}

QPushButton[class="btn-danger"]:hover {
    background-color: #F43F5E;
    color: #FFFFFF;
    border-color: #F43F5E;
}

QPushButton[class="btn-success"] {
    background-color: #ECFDF5;
    color: #10B981;
    border: 1px solid #A7F3D0;
    font-weight: 600;
}

QPushButton[class="btn-success"]:hover {
    background-color: #10B981;
    color: #FFFFFF;
    border-color: #10B981;
}


/* ═══════════════════════════════════════════════════════════════════════════
   5. INPUT FIELDS — Neumorphic Inset
   ═══════════════════════════════════════════════════════════════════════════ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #F1F5F9;
    color: #0F172A;
    border-top: 1px solid #CBD5E1;
    border-left: 1px solid #CBD5E1;
    border-bottom: 1px solid #FFFFFF;
    border-right: 1px solid #FFFFFF;
    border-radius: 12px;
    padding: 6px 12px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid rgba(79, 107, 251, 0.35);
    background-color: #FFFFFF;
}

QLineEdit::placeholder {
    color: #94A3B8;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    selection-background-color: #EEF2FF;
    selection-color: #4F6BFB;
}


/* ═══════════════════════════════════════════════════════════════════════════
   6. TABLES & LISTS — Neumorphic Inset Container with Raised Rows
   ═══════════════════════════════════════════════════════════════════════════ */
QTableView, QTableWidget, QListView, QListWidget, QTreeView {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    gridline-color: transparent;
    alternate-background-color: #F8FAFC;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-right: 1px solid #F1F5F9;
    font-weight: 600;
    font-size: 12px;
}

QTableView::item, QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #F1F5F9;
    color: #0F172A;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #EEF2FF;
    color: #4F6BFB;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: rgba(79, 107, 251, 0.06);
}


/* ═══════════════════════════════════════════════════════════════════════════
   7. SCROLLBARS — Minimal Translucent
   ═══════════════════════════════════════════════════════════════════════════ */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: rgba(15, 23, 42, 0.10);
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(15, 23, 42, 0.20);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: rgba(15, 23, 42, 0.10);
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(15, 23, 42, 0.20);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
    width: 0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   8. STATUS BAR — Frosted Glass Bottom Strip
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame#StatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}

QLabel[class="status-metric"] {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
    color: #64748B;
}

QLabel[class="metric-value"] {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-weight: bold;
    color: #10B981;
}


/* ═══════════════════════════════════════════════════════════════════════════
   9. BENTO KPI CARDS — Neumorphic Raised
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame[class="kpi-card"] {
    background-color: #F1F5F9;
    border: 1px solid rgba(255, 255, 255, 200);
    border-radius: 18px;
    padding: 12px;
}

QFrame[class="kpi-card"]:hover {
    background-color: #FFFFFF;
}

QLabel[class="kpi-title"] {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QLabel[class="kpi-val"] {
    color: #0F172A;
    font-size: 24px;
    font-weight: 700;
}


/* ═══════════════════════════════════════════════════════════════════════════
   10. BADGES & TAGS — Semantic Status Chips
   ═══════════════════════════════════════════════════════════════════════════ */

/* Criminal → High-Contrast Solid Crimson Pill */
QLabel[class="badge-criminal"] {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #B91C1C;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 800;
}

/* Missing → High-Contrast Solid Electric Cyan Pill */
QLabel[class="badge-missing"] {
    background-color: #0284C7;
    color: #FFFFFF;
    border: 1px solid #0369A1;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 800;
}


/* ═══════════════════════════════════════════════════════════════════════════
   11. ALERT SIDEBAR & FROSTED GLASS NOTIFICATION CARDS
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame#AlertSidebar {
    background-color: rgba(255, 255, 255, 235);
    border-left: 1px solid #E2E8F0;
}

QFrame[class~="alert-card"] {
    border-radius: 16px;
}

/* Criminal → Blurred Red Frosted Glass Box */
QFrame[class~="alert-card-criminal"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(254, 226, 226, 0.96), stop:0.45 rgba(254, 205, 211, 0.88), stop:1 rgba(253, 164, 175, 0.76));
    border: 1.5px solid rgba(239, 68, 68, 0.65);
    border-left: 6px solid #DC2626;
}

QFrame[class~="alert-card-criminal"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FEE2E2, stop:0.45 #FECDD3, stop:1 #FDA4AF);
    border: 1.5px solid #DC2626;
    border-left: 6px solid #B91C1C;
}

/* Missing Person → Vivid Electric Cyan-Blue Frosted Glass Box */
QFrame[class~="alert-card-missing"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(224, 242, 254, 0.96), stop:0.45 rgba(186, 230, 253, 0.88), stop:1 rgba(125, 211, 252, 0.76));
    border: 1.5px solid rgba(6, 182, 212, 0.75);
    border-left: 6px solid #00D4FF;
}

QFrame[class~="alert-card-missing"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #E0F2FE, stop:0.45 #BAE6FD, stop:1 #7DD3FC);
    border: 1.5px solid #0891B2;
    border-left: 6px solid #0E7490;
}


/* ═══════════════════════════════════════════════════════════════════════════
   12. CHECKBOXES — Light Theme
   ═══════════════════════════════════════════════════════════════════════════ */
QCheckBox {
    color: #334155;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #CBD5E1;
    background-color: #F1F5F9;
}

QCheckBox::indicator:checked {
    background-color: #4F6BFB;
    border-color: #4F6BFB;
}

QCheckBox::indicator:hover {
    border-color: #4F6BFB;
}


/* ═══════════════════════════════════════════════════════════════════════════
   13. GROUP BOXES — Glass Card Containers
   ═══════════════════════════════════════════════════════════════════════════ */
QGroupBox {
    background-color: rgba(255, 255, 255, 220);
    border: 1px solid #E2E8F0;
    border-radius: 18px;
    margin-top: 14px;
    padding-top: 20px;
    font-weight: 600;
    color: #4F6BFB;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    background-color: #F8FAFC;
    border-radius: 8px;
    left: 14px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   14. PROGRESS BAR — Accent Stripe
   ═══════════════════════════════════════════════════════════════════════════ */
QProgressBar {
    background-color: #F1F5F9;
    border: none;
    border-radius: 2px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4F6BFB;
    border-radius: 2px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   15. TOOLTIP — Ink Popup
   ═══════════════════════════════════════════════════════════════════════════ */
QToolTip {
    background-color: #0F172A;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 11px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   16. SEPARATOR
   ═══════════════════════════════════════════════════════════════════════════ */
QSplitter::handle {
    background-color: #E2E8F0;
    width: 2px;
}

QFrame[class="separator"] {
    background-color: #E2E8F0;
    max-height: 1px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   17. SCROLL AREA — Transparent Container
   ═══════════════════════════════════════════════════════════════════════════ */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}


/* ═══════════════════════════════════════════════════════════════════════════
   18. TAB WIDGET (if ever used)
   ═══════════════════════════════════════════════════════════════════════════ */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #64748B;
    padding: 8px 16px;
    border-radius: 8px 8px 0 0;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #4F6BFB;
    font-weight: 600;
}


/* ═══════════════════════════════════════════════════════════════════════════
   19. DIALOG — Glassmorphic Modal
   ═══════════════════════════════════════════════════════════════════════════ */
QDialog {
    background-color: #F8FAFC;
    color: #0F172A;
    border-radius: 18px;
}

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #334155;
}
