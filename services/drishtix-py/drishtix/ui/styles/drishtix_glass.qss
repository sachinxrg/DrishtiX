

/* ==========================================================================
   DrishtiX v5.0 — Light Glassmorphism + Soft Neumorphism Theme (QSS)
   ==========================================================================
   GENERATED from theme_tokens.py — do NOT hand-edit this file.
   Run: python tools/generate_qss.py
   ========================================================================== */


/* ═══════════════════════════════════════════════════════════════════════════
   1. GLOBAL RESET & WINDOW — Ambient Canvas
   ═══════════════════════════════════════════════════════════════════════════ */
QWidget {
    background-color: #F7F8FA;
    color: #0F172A;
    font-family: "Inter", "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
    selection-background-color: #3E56E0;
    selection-color: #FFFFFF;
}

QMainWindow {
    background-color: #F7F8FA;
}


/* ═══════════════════════════════════════════════════════════════════════════
   2. FRAMES & BENTO CARDS — Glassmorphic Surfaces
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame[class="bento-card"], QFrame[class="card-panel"] {
    background-color: rgba(255,255,255,0.88);
    border: 1px solid rgba(255, 255, 255, 220);
    border-radius: 20px;
}

QFrame[class="bento-card"]:hover, QFrame[class="card-panel"]:hover {
    border: 1px solid #FFFFFF;
}

/* Glass Card Variants */
QFrame[class="glass-card"] {
    background-color: rgba(255,255,255,0.78);
    border: 1px solid rgba(255, 255, 255, 230);
    border-radius: 20px;
}

QFrame[class="glass-card"]:hover {
    border: 1px solid #FFFFFF;
}

QFrame[class="glass-card-heavy"] {
    background-color: rgba(255,255,255,0.88);
    border: 1px solid rgba(255, 255, 255, 240);
    border-radius: 20px;
}

QFrame[class="glass-card-elevated"] {
    background-color: rgba(255,255,255,0.82);
    border: 1px solid rgba(255, 255, 255, 240);
    border-radius: 20px;
}

QFrame[class="glass-sidebar"] {
    background-color: rgba(255,255,255,0.96);
    border: 1px solid rgba(255, 255, 255, 240);
    border-radius: 0px;
}

QFrame[class="glass-overlay"] {
    background-color: rgba(255,255,255,0.88);
    border: 1px solid rgba(255, 255, 255, 220);
    border-radius: 22px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   2b. NEUMORPHIC VARIANTS
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame[class="neu-raised"] {
    background-color: #F0F2F6;
    border-top: 1px solid #FFFFFF;
    border-left: 1px solid #FFFFFF;
    border-bottom: 1px solid #CAD1DC;
    border-right: 1px solid #CAD1DC;
    border-radius: 20px;
}

QFrame[class="neu-raised"]:hover {
    background-color: #FFFFFF;
}

QFrame[class="neu-inset"] {
    background-color: #F0F2F6;
    border-top: 1px solid #CAD1DC;
    border-left: 1px solid #CAD1DC;
    border-bottom: 1px solid #FFFFFF;
    border-right: 1px solid #FFFFFF;
    border-radius: 12px;
}

QFrame[class="neu-pressed"] {
    background-color: #E1E5EC;
    border-top: 1px solid #CAD1DC;
    border-left: 1px solid #CAD1DC;
    border-bottom: 1px solid #FFFFFF;
    border-right: 1px solid #FFFFFF;
    border-radius: 12px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   2c. BENTO TILES
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame[class="bento-tile"] {
    background-color: transparent;
    border: none;
    border-radius: 0px;
}

QFrame[class="bento-tile-hero"] {
    background-color: transparent;
    border: none;
    border-radius: 0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   3. NAVIGATION SIDEBAR — Modern Command Strip
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame#NavSidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E1E5EC;
}

QPushButton[class="nav-btn"] {
    background-color: transparent;
    color: #475569;
    text-align: left;
    padding: 10px 14px;
    border-radius: 12px;
    font-weight: 500;
    font-size: 13.5px;
    border: none;
}

QPushButton[class="nav-btn"]:hover:!checked {
    background-color: #EEF2FF;
    color: #0F172A;
}

QPushButton[class="nav-btn"]:checked {
    background: transparent;
    color: #FFFFFF;
    font-weight: 600;
    border: none;
    border-radius: 12px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   4. BUTTONS — Neumorphic & Accent Controls
   ═══════════════════════════════════════════════════════════════════════════ */
QPushButton {
    background-color: #F0F2F6;
    color: #0F172A;
    border: 1px solid rgba(255, 255, 255, 220);
    border-radius: 12px;
    padding: 8px 16px;
    font-weight: 500;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #FFFFFF;
    border-color: #E1E5EC;
}

QPushButton:pressed {
    background-color: #E1E5EC;
    border-top: 1px solid #CAD1DC;
    border-left: 1px solid #CAD1DC;
    border-bottom: 1px solid #FFFFFF;
    border-right: 1px solid #FFFFFF;
}

QPushButton:disabled {
    background-color: #F0F2F6;
    color: #94A0B2;
    border-color: #E1E5EC;
}

QPushButton[class="btn-primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4F6BFB, stop:1 #3E56E0);
    color: #FFFFFF;
    border: 1px solid #3347C7;
    font-weight: 600;
    border-radius: 12px;
    padding: 8px 18px;
}

QPushButton[class="btn-primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3347C7, stop:1 #283593);
    border-color: #283593;
}

QPushButton[class="btn-primary"]:pressed {
    background-color: #283593;
}

QPushButton[class="btn-danger"] {
    background-color: #FFF1F2;
    color: #DC2626;
    border: 1px solid #FECDD3;
    font-weight: 600;
    border-radius: 12px;
}

QPushButton[class="btn-danger"]:hover {
    background-color: #DC2626;
    color: #FFFFFF;
    border-color: #B91C1C;
}

QPushButton[class="btn-danger-ghost"] {
    background-color: transparent;
    color: #F43F5E;
    border: 1px solid transparent;
    font-weight: 500;
    border-radius: 12px;
}

QPushButton[class="btn-danger-ghost"]:hover {
    background-color: #FFF1F2;
    border-color: #FECDD3;
    color: #DC2626;
}

QPushButton[class="btn-success"] {
    background-color: #ECFDF5;
    color: #047857;
    border: 1px solid #A7F3D0;
    font-weight: 600;
    border-radius: 12px;
}

QPushButton[class="btn-success"]:hover {
    background-color: #10B981;
    color: #FFFFFF;
    border-color: #047857;
}


/* ═══════════════════════════════════════════════════════════════════════════
   5. INPUT FIELDS — Neumorphic Inset
   ═══════════════════════════════════════════════════════════════════════════ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #F0F2F6;
    color: #0F172A;
    border-top: 1px solid #CAD1DC;
    border-left: 1px solid #CAD1DC;
    border-bottom: 1px solid #FFFFFF;
    border-right: 1px solid #FFFFFF;
    border-radius: 12px;
    padding: 7px 12px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid rgba(62,86,224,0.30);
    background-color: #FFFFFF;
}

QLineEdit::placeholder {
    color: #94A0B2;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EC;
    border-radius: 12px;
    selection-background-color: #EEF2FF;
    selection-color: #3E56E0;
}


/* ═══════════════════════════════════════════════════════════════════════════
   6. TABLES & LISTS — Modern Clean Container
   ═══════════════════════════════════════════════════════════════════════════ */
QTableView, QTableWidget, QListView, QListWidget, QTreeView {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EC;
    border-radius: 12px;
    gridline-color: transparent;
    alternate-background-color: #F7F8FA;
}

QHeaderView::section {
    background-color: #F7F8FA;
    color: #64748B;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #E1E5EC;
    border-right: 1px solid #F0F2F6;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QTableView::item, QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #F0F2F6;
    color: #0F172A;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #EEF2FF;
    color: #3E56E0;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: rgba(79, 107, 251, 0.05);
}


/* ═══════════════════════════════════════════════════════════════════════════
   7. SCROLLBARS — Minimal Translucent
   ═══════════════════════════════════════════════════════════════════════════ */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: rgba(15, 23, 42, 0.12);
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(15, 23, 42, 0.24);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: rgba(15, 23, 42, 0.12);
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(15, 23, 42, 0.24);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
    width: 0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   8. STATUS BAR — Frosted Glass Bottom Strip
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame#StatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E1E5EC;
}

QLabel[class="status-metric"] {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
    color: #64748B;
}

QLabel[class="metric-value"] {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-weight: bold;
    color: #10B981;
}

/* Status Bar Capsules */
QLabel[class="status-capsule-safe"] {
    background-color: #ECFDF5;
    color: #047857;
    border: 1px solid #A7F3D0;
    border-radius: 8px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="status-capsule-warning"] {
    background-color: #FFFBEB;
    color: #B45309;
    border: 1px solid #FDE68A;
    border-radius: 8px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="status-capsule-critical"] {
    background-color: #FFF1F2;
    color: #F43F5E;
    border: 1px solid #FECDD3;
    border-radius: 8px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="status-capsule-info"] {
    background-color: #ECFEFF;
    color: #0369A1;
    border: 1px solid #A5F3FC;
    border-radius: 8px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="status-capsule-neutral"] {
    background-color: #F0F2F6;
    color: #64748B;
    border: 1px solid #E1E5EC;
    border-radius: 8px;
    padding: 3px 10px;
    font-weight: 600;
    font-size: 11px;
}

QLabel[class="status-capsule-accent"] {
    background-color: #EEF2FF;
    color: #3E56E0;
    border: 1px solid #C7D2FE;
    border-radius: 8px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[mono="true"] {
    font-family: "JetBrains Mono", "Consolas", monospace;
}


/* ═══════════════════════════════════════════════════════════════════════════
   9. BENTO KPI CARDS — Neumorphic / Glass Hybrid
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame[class="kpi-card"] {
    background-color: rgba(255,255,255,0.82);
    border: 1px solid rgba(255, 255, 255, 240);
    border-radius: 20px;
    padding: 14px 16px;
}

QFrame[class="kpi-card"]:hover {
    background-color: #FFFFFF;
    border-color: #E1E5EC;
}

QLabel[class="kpi-title"] {
    color: #64748B;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

QLabel[class="kpi-val"] {
    color: #0F172A;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.5px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   10. PILLS & BADGES — Semantic Status
   ═══════════════════════════════════════════════════════════════════════════ */
QLabel[class="pill-live"] {
    background-color: #ECFDF5;
    color: #047857;
    border: 1px solid #A7F3D0;
    border-radius: 999px;
    padding: 3px 12px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="pill-offline"] {
    background-color: #FFF1F2;
    color: #F43F5E;
    border: 1px solid #FECDD3;
    border-radius: 999px;
    padding: 3px 12px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="pill-safe"] {
    background-color: #ECFDF5;
    color: #047857;
    border: 1px solid #A7F3D0;
    border-radius: 999px;
    padding: 3px 12px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="pill-warning"] {
    background-color: #FFFBEB;
    color: #B45309;
    border: 1px solid #FDE68A;
    border-radius: 999px;
    padding: 3px 12px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="pill-critical"] {
    background-color: #FFF1F2;
    color: #F43F5E;
    border: 1px solid #FECDD3;
    border-radius: 999px;
    padding: 3px 12px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="pill-info"] {
    background-color: #ECFEFF;
    color: #0369A1;
    border: 1px solid #A5F3FC;
    border-radius: 999px;
    padding: 3px 12px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="pill-accent"] {
    background-color: #EEF2FF;
    color: #3E56E0;
    border: 1px solid #C7D2FE;
    border-radius: 999px;
    padding: 3px 12px;
    font-weight: 700;
    font-size: 11px;
}

QLabel[class="pill-neutral"] {
    background-color: #F0F2F6;
    color: #64748B;
    border: 1px solid #CAD1DC;
    border-radius: 999px;
    padding: 2px 8px;
    font-weight: 600;
    font-size: 10.5px;
}

/* Category badges (Softer, modern pills) */
QLabel[class="badge-criminal"] {
    background-color: #FFF1F2;
    color: #DC2626;
    border: 1px solid #FECDD3;
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

QLabel[class="badge-missing"] {
    background-color: #ECFEFF;
    color: #0369A1;
    border: 1px solid #A5F3FC;
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   11. TYPOGRAPHY SCALE CLASSES
   ═══════════════════════════════════════════════════════════════════════════ */
QLabel[class="type-display"] {
    font-size: 28px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: -0.5px;
}

QLabel[class="type-h1"] {
    font-size: 22px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: -0.3px;
}

QLabel[class="type-h2"] {
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: -0.2px;
}

QLabel[class="type-h3"] {
    font-size: 15px;
    font-weight: 600;
    color: #0F172A;
    letter-spacing: -0.1px;
}

QLabel[class="type-body"] {
    font-size: 13px;
    font-weight: 500;
    color: #334155;
}

QLabel[class="type-caption"] {
    font-size: 11px;
    font-weight: 500;
    color: #475569;
    letter-spacing: 0.2px;
}

QLabel[class="type-micro"] {
    font-size: 10px;
    font-weight: 600;
    color: #64748B;
    letter-spacing: 0.4px;
}

/* Backward compatibility aliases */
QLabel[class="view-title"] {
    font-weight: 700;
    font-size: 16px;
    color: #0F172A;
    letter-spacing: -0.2px;
}

QLabel[class="view-subtitle"] {
    font-size: 12px;
    color: #475569;
    letter-spacing: 0.1px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   12. VIDEO SURFACE — Dark Inset Bezel
   ═══════════════════════════════════════════════════════════════════════════ */
QLabel[class="video-surface"] {
    background-color: #0F172A;
    border-radius: 12px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   13. ALERT SIDEBAR & FROSTED GLASS NOTIFICATION CARDS
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame#AlertSidebar {
    background-color: rgba(255,255,255,0.96);
    border-left: 1px solid #E1E5EC;
}

QFrame[class~="alert-card"] {
    border-radius: 14px;
}

QFrame[class~="alert-card-criminal"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(255, 241, 242, 0.95), stop:1 rgba(254, 226, 226, 0.85));
    border: 1px solid rgba(239, 68, 68, 0.40);
    border-left: 4px solid #DC2626;
}

QFrame[class~="alert-card-criminal"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FFF1F2, stop:1 #FEE2E2);
    border: 1px solid #F43F5E;
    border-left: 4px solid #B91C1C;
}

QFrame[class~="alert-card-missing"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(236, 254, 255, 0.95), stop:1 rgba(224, 242, 254, 0.85));
    border: 1px solid rgba(6, 182, 212, 0.40);
    border-left: 4px solid #00D4FF;
}

QFrame[class~="alert-card-missing"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ECFEFF, stop:1 #E0F2FE);
    border: 1px solid #0891B2;
    border-left: 4px solid #0369A1;
}

/* Alert card sub-elements */
QFrame[class="alert-thumb-criminal"] {
    background-color: #FFF1F2;
    border-radius: 10px;
    border: 1.5px solid rgba(239,68,68,0.45);
}

QFrame[class="alert-thumb-missing"] {
    background-color: #ECFEFF;
    border-radius: 10px;
    border: 1.5px solid rgba(6,182,212,0.45);
}


/* ═══════════════════════════════════════════════════════════════════════════
   14. EMPTY & LOADING STATES
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame[class="empty-state"] {
    background: rgba(255, 255, 255, 0.7);
    border: 1px dashed #CAD1DC;
    border-radius: 16px;
    padding: 30px 16px;
}

QLabel[class="empty-state-icon"] {
    font-size: 28px;
    background: transparent;
    border: none;
}

QLabel[class="empty-state-message"] {
    color: #64748B;
    font-size: 12.5px;
    font-weight: 500;
    background: transparent;
    border: none;
}


/* ═══════════════════════════════════════════════════════════════════════════
   15. CHECKBOXES — Light Theme
   ═══════════════════════════════════════════════════════════════════════════ */
QCheckBox {
    color: #334155;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #CAD1DC;
    background-color: #F0F2F6;
}

QCheckBox::indicator:checked {
    background-color: #3E56E0;
    border-color: #3E56E0;
}

QCheckBox::indicator:hover {
    border-color: #3E56E0;
}


/* ═══════════════════════════════════════════════════════════════════════════
   16. GROUP BOXES — Glass Card Containers
   ═══════════════════════════════════════════════════════════════════════════ */
QGroupBox {
    background-color: rgba(255,255,255,0.88);
    border: 1px solid #E1E5EC;
    border-radius: 20px;
    margin-top: 14px;
    padding-top: 20px;
    font-weight: 600;
    color: #3E56E0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    background-color: #F7F8FA;
    border-radius: 8px;
    left: 14px;
}

/* Per-section colored group boxes */
QGroupBox[class="grp-camera"]    { color: #3E56E0; }
QGroupBox[class="grp-dnn"]      { color: #10B981; }
QGroupBox[class="grp-alert"]    { color: #F43F5E; }
QGroupBox[class="grp-database"] { color: #F59E0B; }


/* ═══════════════════════════════════════════════════════════════════════════
   17. PROGRESS BAR — Accent Stripe
   ═══════════════════════════════════════════════════════════════════════════ */
QProgressBar {
    background-color: #F0F2F6;
    border: none;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3E56E0;
    border-radius: 3px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   18. TOOLTIP — Ink Popup
   ═══════════════════════════════════════════════════════════════════════════ */
QToolTip {
    background-color: #0F172A;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 11px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   19. SEPARATOR
   ═══════════════════════════════════════════════════════════════════════════ */
QSplitter::handle {
    background-color: #E1E5EC;
    width: 2px;
}

QFrame[class="separator"] {
    background-color: #E1E5EC;
    max-height: 1px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   20. SCROLL AREA — Transparent Container
   ═══════════════════════════════════════════════════════════════════════════ */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}


/* ═══════════════════════════════════════════════════════════════════════════
   21. TAB WIDGET
   ═══════════════════════════════════════════════════════════════════════════ */
QTabWidget::pane {
    border: 1px solid #E1E5EC;
    border-radius: 12px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #F0F2F6;
    color: #64748B;
    padding: 8px 16px;
    border-radius: 8px 8px 0 0;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #3E56E0;
    font-weight: 600;
}


/* ═══════════════════════════════════════════════════════════════════════════
   22. DIALOG — Glassmorphic Modal
   ═══════════════════════════════════════════════════════════════════════════ */
QDialog {
    background-color: #F7F8FA;
    color: #0F172A;
    border-radius: 20px;
}

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #334155;
}


/* ═══════════════════════════════════════════════════════════════════════════
   23. FOCUS RINGS — Universal Accessibility
   ═══════════════════════════════════════════════════════════════════════════ */
QPushButton:focus, QLineEdit:focus, QTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QCheckBox:focus, QTableView:focus, QListView:focus {
    border: 2px solid rgba(62,86,224,0.30);
}
