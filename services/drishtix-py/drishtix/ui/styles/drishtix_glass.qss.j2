}

QFrame[class~="alert-card-missing"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ECFEFF, stop:1 #E0F2FE);
    border: 1px solid {{ color.INFO_BOLD }};
    border-left: 4px solid {{ color.INFO_SKY }};
}

/* Alert card sub-elements */
QFrame[class="alert-thumb-criminal"] {
    background-color: {{ color.ALERT_CRIMINAL_THUMB_BG }};
    border-radius: 10px;
    border: 1.5px solid {{ color.ALERT_CRIMINAL_THUMB_BD }};
}

QFrame[class="alert-thumb-missing"] {
    background-color: {{ color.ALERT_MISSING_THUMB_BG }};
    border-radius: 10px;
    border: 1.5px solid {{ color.ALERT_MISSING_THUMB_BD }};
}


/* ═══════════════════════════════════════════════════════════════════════════
   14. EMPTY & LOADING STATES
   ═══════════════════════════════════════════════════════════════════════════ */
QFrame[class="empty-state"] {
    background: rgba(255, 255, 255, 0.7);
    border: 1px dashed {{ color.BORDER_MUTED }};
    border-radius: 16px;
    padding: 30px 16px;
}

QLabel[class="empty-state-icon"] {
    font-size: 28px;
    background: transparent;
    border: none;
}

QLabel[class="empty-state-message"] {
    color: {{ color.TEXT_MUTED }};
    font-size: 12.5px;
    font-weight: 500;
    background: transparent;
    border: none;
}


/* ═══════════════════════════════════════════════════════════════════════════
   15. CHECKBOXES — Light Theme
   ═══════════════════════════════════════════════════════════════════════════ */
QCheckBox {
    color: {{ color.TEXT_BODY }};
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: {{ radius.CHECKBOX }}px;
    border: 1px solid {{ color.BORDER_MUTED }};
    background-color: {{ color.NEU_SURFACE }};
}

QCheckBox::indicator:checked {
    background-color: {{ color.ACCENT }};
    border-color: {{ color.ACCENT }};
}

QCheckBox::indicator:hover {
    border-color: {{ color.ACCENT }};
}


/* ═══════════════════════════════════════════════════════════════════════════
   16. GROUP BOXES — Glass Card Containers
   ═══════════════════════════════════════════════════════════════════════════ */
QGroupBox {
    background-color: {{ color.SURFACE_GLASS_HEAVY }};
    border: 1px solid {{ color.BORDER_SUBTLE }};
    border-radius: {{ radius.CARD }}px;
    margin-top: 14px;
    padding-top: 20px;
    font-weight: 600;
    color: {{ color.ACCENT }};
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    background-color: {{ color.CANVAS }};
    border-radius: {{ radius.SMALL }}px;
    left: 14px;
}

/* Per-section colored group boxes */
QGroupBox[class="grp-camera"]    { color: {{ color.ACCENT }}; }
QGroupBox[class="grp-dnn"]      { color: {{ color.SAFE }}; }
QGroupBox[class="grp-alert"]    { color: {{ color.CRITICAL }}; }
QGroupBox[class="grp-database"] { color: {{ color.WARNING }}; }


/* ═══════════════════════════════════════════════════════════════════════════
   17. PROGRESS BAR — Accent Stripe
   ═══════════════════════════════════════════════════════════════════════════ */
QProgressBar {
    background-color: {{ color.NEU_SURFACE }};
    border: none;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: {{ color.ACCENT }};
    border-radius: 3px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   18. TOOLTIP — Ink Popup
   ═══════════════════════════════════════════════════════════════════════════ */
QToolTip {
    background-color: {{ color.TEXT_PRIMARY }};
    color: {{ color.WHITE }};
    border: none;
    border-radius: {{ radius.SMALL }}px;
    padding: 6px 10px;
    font-size: 11px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   19. SEPARATOR
   ═══════════════════════════════════════════════════════════════════════════ */
QSplitter::handle {
    background-color: {{ color.BORDER_SUBTLE }};
    width: 2px;
}

QFrame[class="separator"] {
    background-color: {{ color.BORDER_SUBTLE }};
    max-height: 1px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   20. SCROLL AREA — Transparent Container
   ═══════════════════════════════════════════════════════════════════════════ */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}


/* ═══════════════════════════════════════════════════════════════════════════
   21. TAB WIDGET
   ═══════════════════════════════════════════════════════════════════════════ */
QTabWidget::pane {
    border: 1px solid {{ color.BORDER_SUBTLE }};
    border-radius: {{ radius.CONTROL }}px;
    background-color: {{ color.WHITE }};
}

QTabBar::tab {
    background-color: {{ color.NEU_SURFACE }};
    color: {{ color.TEXT_MUTED }};
    padding: 8px 16px;
    border-radius: {{ radius.SMALL }}px {{ radius.SMALL }}px 0 0;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: {{ color.WHITE }};
    color: {{ color.ACCENT }};
    font-weight: 600;
}


/* ═══════════════════════════════════════════════════════════════════════════
   22. DIALOG — Glassmorphic Modal
   ═══════════════════════════════════════════════════════════════════════════ */
QDialog {
    background-color: {{ color.CANVAS }};
    color: {{ color.TEXT_PRIMARY }};
    border-radius: {{ radius.CARD }}px;
}

QMessageBox {
    background-color: {{ color.WHITE }};
}

QMessageBox QLabel {
    color: {{ color.TEXT_BODY }};
}


/* ═══════════════════════════════════════════════════════════════════════════
   23. FOCUS RINGS — Universal Accessibility
   ═══════════════════════════════════════════════════════════════════════════ */
QPushButton:focus, QLineEdit:focus, QTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QCheckBox:focus, QTableView:focus, QListView:focus {
    border: 2px solid {{ color.ACCENT_FOCUS }};
}
