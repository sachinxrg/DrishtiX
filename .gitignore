# ==============================================================================
# DrishtiX Ecosystem - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
services/*/venv/
services/*/env/
env.bak/
venv.bak/
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# Python Bytecode & Optimization Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ------------------------------------------------------------------------------
# Testing, Coverage & Linting Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
*.local
*credentials*
*secret*
*.pem
*.key
services/drishtix-app/config.properties

# ------------------------------------------------------------------------------
# Application Runtime Data & Local Databases
# ------------------------------------------------------------------------------
data/
services/*/data/
services/drishtix-app/data/
services/drishtix-py/data/
*.db
*.sqlite
*.sqlite3
.reid_service.pid
*.pid

# ------------------------------------------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
*.log
logs/
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# Legacy Java Build Artifacts & Packaging
# ------------------------------------------------------------------------------
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
target/
out/
build/
.gradle/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.mtj.tmp/
*.ctxt

# ------------------------------------------------------------------------------
# IDEs & Editor Metadata
# ------------------------------------------------------------------------------
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# Temporary, Scratch & Build Staging Files
# ------------------------------------------------------------------------------
~$*
scratch/
app_build/
services/drishtix-app/graph TB.txt

# Temporary scripts
*.js
